# Database connection string (Vercel Postgres / Neon / Supabase)
DATABASE_URL=postgres://user:password@host:5432/proof_badges

# Vercel Blob read/write token for image uploads
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_xxxxx

# Deployed BadgeContract address on Base Sepolia
NEXT_PUBLIC_BADGE_CONTRACT=0x0000000000000000000000000000000000000000

# Mock USD ERC-20 contract address on Base Sepolia
NEXT_PUBLIC_MOCK_USD=0x0000000000000000000000000000000000000000

# WalletConnect project ID (get from https://cloud.walletconnect.com)
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=your_project_id_here

# Base Sepolia RPC URL
NEXT_PUBLIC_BASE_SEPOLIA_RPC=https://sepolia.base.org
